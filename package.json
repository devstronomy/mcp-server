{
  "name": "@devstronomy/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Solar System planets and moons",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
